# Environment Variables Template
# Copy this file to .env and fill in your values

# Optional: API keys for future integrations
# OPENAI_API_KEY=your_api_key_here
# GITHUB_TOKEN=your_github_token_here

# Optional: Database configuration (if needed in future)
# DATABASE_URL=sqlite:///security_scan.db

# Optional: ML Model paths (override defaults)
# ML_MODEL_PATH=models/custom_model.pkl

# Optional: Logging configuration
# LOG_LEVEL=INFO
# LOG_FILE=logs/security_scan.log

# Optional: Custom severity rules
# SEVERITY_CONFIG=configs/custom_severity_rules.yaml
